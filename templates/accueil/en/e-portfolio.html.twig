{% extends 'base.html.twig' %}

{% block title %}My E-Portfolio{% endblock %}

{% block body %}
<div class="container my-5">

    <h1 class="text-center mb-4">My E-Portfolio</h1>
    <p class="lead text-center mb-5">Here is the E-portfolio of CHIBOUB Mohamed in BUT RT 1</p>

    {# ===================== Administer ===================== #}
    <section class="mb-5 p-3" style="background-color: #d5f5e3; border-radius: 10px;">
        <h2 class="mb-4">Administer</h2>

        {% set administrer_competences = [
            {
                'title': 'Critical Skill: Administer Networks and the Internet',
                'analyse_link': 'https://docs.google.com/document/d/1K7xRRqMjZPyqPrmULoilApvgpD6SCccR/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/14JY67BZ9ZC_UDkclHhj8uVIEzbEKaC12/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': 'The objective of this skill is to administer various devices and networks.',
                'ressenti': 'During the activities, I generally felt comfortable and interested, especially during the practical phases. I would give myself a 4/5 for this skill.'
                
            },
            
        ] %}

        {% for comp in administrer_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti %}
                        <div class="mt-3 mb-3">
                            <h5>My Feedback and Self-Assessment</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Reflective Analysis</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Supporting Document</a>
                </div>
            </div>
        {% endfor %}
    </section>

    {# ===================== Connect ===================== #}
    <section class="mb-5 p-3" style="background-color: #d0e7f9; border-radius: 10px;">
        <h2 class="mb-4">Connect</h2>

        {% set connecter_competences = [
            {
                'title': 'Critical Skill: Connecting Businesses and Users',
                'analyse_link': 'https://docs.google.com/document/d/1EQMSRwTWrJSPr3_KrxUVS1aD7ICOAqb1/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/1QmMITwrIReT0juCFJhAfOPg_oM_cuFLW/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': 'In this skill, we connected both businesses and users.',
                'ressenti': 'I really enjoyed carrying out the WiFi audit and copper cabling testing. I was able to use professional equipment, and it was fascinating. I would give myself a 4/5 for this skill.'
            },
            
        ] %}

        {% for comp in connecter_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description2 %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti2 %}
                        <div class="mt-3 mb-3">
                            <h5>My Feedback and Self-Assessment</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Reflective Analysis</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Supporting Document</a>
                </div>
            </div>
        {% endfor %}
    </section>

    {# ===================== Tool Creation ===================== #}
    <section class="mb-5 p-3" style="background-color: #fff9c4; border-radius: 10px;">
        <h2 class="mb-4">Tool Creation</h2>

        {% set creation_outil_competences = [
            {
                'title': 'Critical Skill: Creating Tools and Software Applications for Networks & Telecommunications',
                'analyse_link': 'https://docs.google.com/document/d/1vzX3MeXSibVQlBx6v1m1h0rZFBnchQMD/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/1ZevX7Iw48RRBIE-QW21gCMWEuEchqwoy/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': 'In this skill, we explore tool creation. To illustrate this, I will present one of my projects.',
                'ressenti': 'While creating my program, I struggled with some concepts, but thanks to documentation, I managed to achieve what I wanted. I would give myself a 3/5 for this skill.'
            },
            
        ] %}

        {% for comp in creation_outil_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description3 %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti3 %}
                        <div class="mt-3 mb-3">
                            <h5>My Feedback and Self-Assessment</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Reflective Analysis</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Supporting Document</a>
                </div>
            </div>
        {% endfor %}
    </section>

</div>
{% endblock %}