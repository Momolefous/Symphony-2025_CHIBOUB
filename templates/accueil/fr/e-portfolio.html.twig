{% extends 'base.html.twig' %}

{% block title %}Mon E-Portfolio{% endblock %}

{% block body %}
<div class="container my-5">

    <h1 class="text-center mb-4">Mon E-Portfolio</h1>
    <p class="lead text-center mb-5">Voici le E-portfolio de CHIBOUB Mohamed en BUT RT 1</p>

    {# ===================== Administrer ===================== #}
    <section class="mb-5 p-3" style="background-color: #d5f5e3; border-radius: 10px;">
        <h2 class="mb-4">Administrer</h2>

        {% set administrer_competences = [
            {
                'title': 'Compétence critique : Administrer les réseaux et l’internet ',
                'analyse_link': 'https://docs.google.com/document/d/1K7xRRqMjZPyqPrmULoilApvgpD6SCccR/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/14JY67BZ9ZC_UDkclHhj8uVIEzbEKaC12/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': ' Dans cette compétence l objectif est d administrer divers appareils et réseaux ',
                'ressenti': 'Pendant les activités, je me suis senti globalement à l’aise et intéressé, surtout lors des phases pratiques. Je me mettrai un 4/5 comme note individuel sur cette compétence'
                
            },
            
        ] %}

        {% for comp in administrer_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti %}
                        <div class="mt-3 mb-3">
                            <h5>Mon ressenti et positionnement</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Analyse réflexive</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Document de preuve</a>
                </div>
            </div>
        {% endfor %}
    </section>

    {# ===================== Connecter ===================== #}
    <section class="mb-5 p-3" style="background-color: #d0e7f9; border-radius: 10px;">
        <h2 class="mb-4">Connecter</h2>

        {% set connecter_competences = [
            {
                'title': 'Compétence critique : Connecter les entreprise et les usagers ',
                'analyse_link': 'https://docs.google.com/document/d/1EQMSRwTWrJSPr3_KrxUVS1aD7ICOAqb1/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/1QmMITwrIReT0juCFJhAfOPg_oM_cuFLW/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': 'Dans cette compétence nous avons connecter à la fois les entreprise et les usagers.',
                'ressenti': ' j ai beaucoup apprécié réalisé l audit WIFI et la recette cuivre. J ai pu utilisé du matériel profesionnel et c était passionnant, je me mettrai un 4/5 comme note individuel sur cette compétence, '
            },
            
        ] %}

        {% for comp in connecter_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description2 %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti2 %}
                        <div class="mt-3 mb-3">
                            <h5>Mon ressenti et positionnement</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Analyse réflexive</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Document de preuve</a>
                </div>
            </div>
        {% endfor %}
    </section>

    {# ===================== Création d'outil ===================== #}
    <section class="mb-5 p-3" style="background-color: #fff9c4; border-radius: 10px;">
        <h2 class="mb-4">Création d'outil</h2>

        {% set creation_outil_competences = [
            {
                'title': 'Compétence critique : Créer des outils et Application informatique pour les R&T',
                'analyse_link': 'https://docs.google.com/document/d/1vzX3MeXSibVQlBx6v1m1h0rZFBnchQMD/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'preuve_link': 'https://docs.google.com/document/d/1ZevX7Iw48RRBIE-QW21gCMWEuEchqwoy/edit?usp=sharing&ouid=112405732234709398963&rtpof=true&sd=true',
                'description': 'Dans cette compétence nous aborderons la création d’outils pour cela je vais vous présenté un de mes projets.',
                'ressenti': 'Lors de la création de mon programme, j ai eu pas mal de mal sur certaines notions, mais avec de la documentation j ai réussi à faire ce que je voulais. Je me mettrai un 3/5 comme note individuelle sur cette compétence'
            },
            
        ] %}

        {% for comp in creation_outil_competences %}
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">{{ comp.title }}</h3>

                    {% block description3 %}
                        <p class="card-text">{{ comp.description }}</p>
                    {% endblock %}

                    {% block ressenti3 %}
                        <div class="mt-3 mb-3">
                            <h5>Mon ressenti et positionnement</h5>
                            <p>{{ comp.ressenti }}</p>
                        </div>
                    {% endblock %}

                    <a href="{{ comp.analyse_link }}" class="btn btn-primary me-2" target="_blank">Analyse réflexive</a>
                    <a href="{{ comp.preuve_link }}" class="btn btn-secondary" target="_blank">Document de preuve</a>
                </div>
            </div>
        {% endfor %}
    </section>

</div>
{% endblock %}
